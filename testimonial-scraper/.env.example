# Database (Postgres — can reuse the Spark Railway workspace, separate DB)
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/testimonial

# Anthropic (testimonial extraction + summarization)
ANTHROPIC_API_KEY=

# LinkedIn credentials — resolved by EnvCredentialProvider.
# These are a LOCATOR target only; the DB never stores them.
# Prefer a session cookie over username/password where possible.
LINKEDIN_SESSION_COOKIE=
LINKEDIN_USER=
LINKEDIN_PASS=
