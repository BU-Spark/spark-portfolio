{
  "name": "spark-project-gallery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "wrangler deploy",
    "deploy:int": "wrangler deploy --config wrangler.int.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "next lint",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:import": "tsx scripts/import-airtable.ts",
    "db:normalize": "tsx scripts/normalize-client-project.ts",
    "db:fix-repos": "tsx scripts/fix-repo-urls.ts",
    "audit:blurbs": "tsx scripts/audit-blurbs.ts",
    "backfill:roles": "tsx --env-file=.env.local scripts/backfill-person-roles.ts",
    "test:role-json": "tsx --env-file=.env.local scripts/test-role-history-json.ts",
    "user:add": "tsx scripts/add-user.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "next": "^15.1.6",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8",
    "wrangler": "^4.114.0"
  }
}
