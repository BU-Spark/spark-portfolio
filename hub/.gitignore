# Deploy output — regenerated by `node build.mjs` on every build.
dist/
node_modules/

# The repo root .gitignore has bare `*.json` and `*.png` rules (they exist for the
# Python-ish initiatives that keep data files loose). Those swallowed this app's
# package.json, its lockfile, and — worse — assets/spark-logo.png, so the first
# commit of this page shipped WITHOUT the hologram image that is the centre of the
# design. A fresh clone had no logo and nothing failed: build.mjs does not read it
# and CI only diffs index.html.
#
# atlas/.gitignore carries the same two re-includes for the same reason.
!*.json
!*.png
