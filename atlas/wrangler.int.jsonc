{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spark-portfolio-int",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "48e24f5e423548dbb73b44900e9d1cc1"
    }
  ],
  "routes": [
    {
      "pattern": "int.atlas.buspark.io",
      "custom_domain": true
    }
  ],
  // See wrangler.jsonc for why these live in config rather than as dashboard vars.
  // Same sender as prod: the point of testing here is to prove the real sender
  // actually delivers, which a different address wouldn't establish.
  "vars": {
    "NEXTAUTH_URL": "https://int.atlas.buspark.io",
    "EMAIL_FROM": "no-reply@buspark.io",
    "EMAIL_REPLY_TO": "buspark@bu.edu"
  },
  "observability": {
    "enabled": true
  }
}
