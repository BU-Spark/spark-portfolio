---
// SSR: winners declared through /dashboard live in Postgres and should appear
// here without a redeploy. Markdown-declared winners (legacy `winner:`
// frontmatter) still count, so nothing already published disappears.
export const prerender = false;

import { getCollection } from 'astro:content';
import Site from '../layouts/Site.astro';
import { track } from '../lib/tracks';
import { isPubliclyVisible } from '../lib/spine';
import { withDb, hallOfFame } from '../lib/db';

const entries = await getCollection('bounties');

/** No `term` field exists on a bounty, so derive it from a date. */
function term(iso: string): string {
  const d = new Date(iso.length === 10 ? iso + 'T00:00:00' : iso);
  if (isNaN(d.getTime())) return '';
  const m = d.getMonth() + 1;
  const season = m <= 5 ? 'SPRING' : m <= 8 ? 'SUMMER' : 'FALL';
  return `${season} '${String(d.getFullYear()).slice(2)}`;
}

type Inductee = {
  slug: string;
  title: string;
  prize: number;
  winner: string;
  submission: string;
  trackId: string;
  term: string;
};

const inductees = new Map<string, Inductee>();

// 1. Legacy: winners recorded in frontmatter.
for (const e of entries) {
  if (isPubliclyVisible(e.data.visibility) && e.data.status === 'completed' && e.data.winner) {
    inductees.set(e.slug, {
      slug: e.slug,
      title: e.data.title,
      prize: e.data.prize,
      winner: e.data.winner,
      submission: e.data.winnerSubmission || '',
      trackId: e.data.track,
      term: term(e.data.deadline),
    });
  }
}

// 2. Live: rows marked complete via the dashboard. These win over frontmatter
// for the same slug — the database is where declarations are made now.
// Fails soft: a public page should degrade to the legacy list, not to an
// infrastructure error. The dashboard is where an unreachable DB is loud.
try {
  const rows = await withDb(Astro.locals, hallOfFame);
  for (const r of rows) {
    const e = entries.find((x) => x.slug === r.bounty_slug);
    // A bounty hidden from the public board stays hidden here too.
    if (e && !isPubliclyVisible(e.data.visibility)) continue;
    inductees.set(r.bounty_slug, {
      slug: r.bounty_slug,
      title: e?.data.title ?? r.bounty_slug,
      // Prefer the actual payout; fall back to the advertised prize.
      prize: r.payout_cents > 0 ? r.payout_cents / 100 : (e?.data.prize ?? 0),
      winner: r.names,
      submission: r.submission_url ?? '',
      trackId: e?.data.track ?? 'spark',
      term: term(r.completed_at),
    });
  }
} catch (err) {
  console.error(
    'Hall of Fame: database unreachable, showing legacy entries only:',
    err instanceof Error ? err.message : err
  );
}

const list = [...inductees.values()].sort(
  (a, b) => b.term.localeCompare(a.term) || b.prize - a.prize
);
const total = list.reduce((sum, i) => sum + i.prize, 0);
---

<Site
  nav="hall"
  title="Hall of Fame — Spark! Bounties"
  description="Every completed bounty and the builder behind it. Names are permanent."
>
  <section class="hero hero-hof">
    <div>
      <h1>They shipped. <em class="gold">They claimed.</em></h1>
      <p>
        Every completed bounty and the builder behind it. Names are permanent.
        {total > 0 && <> ${total.toLocaleString('en-US')} paid out so far.</>}
      </p>
    </div>
    <!-- decorative: the heading already says what this page is -->
    <svg class="trophy" viewBox="0 0 160 200" aria-hidden="true">
      <defs>
        <linearGradient id="tg" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f3d27a" />
          <stop offset=".55" stop-color="var(--gold)" />
          <stop offset="1" stop-color="var(--gold-ink)" />
        </linearGradient>
        <linearGradient id="ts" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#fff" stop-opacity=".55" />
          <stop offset="1" stop-color="#fff" stop-opacity="0" />
        </linearGradient>
      </defs>
      <!-- handles -->
      <path d="M30 40h-14a10 10 0 0 0-10 10c0 26 16 44 38 50" fill="none" stroke="url(#tg)" stroke-width="10" stroke-linecap="round" />
      <path d="M130 40h14a10 10 0 0 1 10 10c0 26-16 44-38 50" fill="none" stroke="url(#tg)" stroke-width="10" stroke-linecap="round" />
      <!-- cup -->
      <path d="M30 22h100v40c0 34-22 60-50 60S30 96 30 62Z" fill="url(#tg)" />
      <path d="M40 30h80v30c0 28-18 50-40 50S40 88 40 60Z" fill="url(#ts)" />
      <!-- stem + base -->
      <rect x="72" y="120" width="16" height="26" rx="4" fill="url(#tg)" />
      <path d="M50 150h60a8 8 0 0 1 8 8v12H42v-12a8 8 0 0 1 8-8Z" fill="url(#tg)" />
      <rect x="36" y="170" width="88" height="14" rx="5" fill="var(--gold-ink)" />
      <!-- the Spark! bang, cut into the cup -->
      <rect x="75" y="42" width="10" height="34" rx="5" fill="var(--bg)" />
      <circle cx="80" cy="90" r="6" fill="var(--bg)" />
    </svg>
  </section>

  <div class="grid-3" style="padding-top:32px">
    {
      list.map((i) => {
        const t = track(i.trackId);
        return (
          <div class="hof">
            <div class="hof-top">
              <span class="inducted">
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2h10v3.5C13 9 10.8 11 8 11S3 9 3 5.5Zm-2 1h2v3H2.5A1.5 1.5 0 0 1 1 4.5Zm12 0h2v1.5A1.5 1.5 0 0 1 13.5 6H13ZM7 11h2v2h2.5v1.5H4.5V13H7Z" /></svg>
                INDUCTED · {i.term}
              </span>
              <span class={`badge badge-${t.variant}`} style="font-size:10px;padding:3px 8px">
                {t.label}
              </span>
            </div>
            <h3>{i.title}</h3>
            <div class="by">
              by <b>{i.winner}</b>
            </div>
            <div class="hof-foot">
              {i.submission ? (
                <a href={i.submission} target="_blank" rel="noopener" style="font-size:12px;color:var(--accent);font-weight:600">
                  View submission →
                </a>
              ) : (
                <span>Claimed</span>
              )}
              <b>${i.prize.toLocaleString('en-US')}</b>
            </div>
          </div>
        );
      })
    }

    <div class="hof-open">
      <svg class="ghost" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 2h10v3.5C13 9 10.8 11 8 11S3 9 3 5.5Zm-2 1h2v3H2.5A1.5 1.5 0 0 1 1 4.5Zm12 0h2v1.5A1.5 1.5 0 0 1 13.5 6H13ZM7 11h2v2h2.5v1.5H4.5V13H7Z" /></svg>
      <div class="small">This spot is open.</div>
      <div class="big">Your name goes here</div>
      <a class="btn btn-inline" href="/">Browse open bounties →</a>
    </div>
  </div>
</Site>
