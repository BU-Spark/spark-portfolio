{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Cloudflare Workers service EXACTLY. Workers Builds runs
  // `wrangler deploy`, which refuses when this name differs from the service
  // it is attached to. atlas/wrangler.int.jsonc <-> spark-portfolio-int is the
  // pattern that works; "spark-bounties" here against a service called
  // bounties-site is what broke the build.
  "name": "bounties-site",
  "compatibility_date": "2026-07-24",
  // Required by `pg`, which reaches for node:net/node:tls. (It was previously
  // required for node:crypto's MD5 — that need went away with Mailchimp, but
  // the Postgres driver needs the flag regardless.) atlas sets the same flag.
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler runs this itself before bundling, so `wrangler versions upload`
  // and `wrangler deploy` cannot be invoked against a dist/ that was never
  // generated. Workers Builds has a "Build command" field in the dashboard that
  // does the same job, but it is invisible to this repo and was twice left
  // empty — producing `The entry-point file at "dist/_worker.js/index.js" was
  // not found`, which reads like a code fault and is not one. Declaring it here
  // makes the deploy self-contained and reviewable.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "main": "./dist/_worker.js/index.js",
  // HYPERDRIVE IS REQUIRED IN PRODUCTION. It is not an optimisation here.
  //
  // A direct DATABASE_URL connection works locally and CANNOT work from a
  // Worker, for a reason that has nothing to do with the code. Railway's
  // Postgres serves a certificate from a private CA:
  //
  //     subject CN=localhost   issuer CN=root-ca
  //     SAN     DNS:localhost, DNS:postgres-b1fc.railway.internal
  //
  // Node accepts that when told `rejectUnauthorized: false`. The Workers
  // runtime has no equivalent — connect()/startTls() validate against
  // Cloudflare's trust store with no documented way to opt out — so the
  // handshake fails and pg reports the generic
  // "Connection terminated unexpectedly". That is what production showed
  // with DATABASE_URL correctly set.
  //
  // Hyperdrive can be told which CA to trust, so it is the way in. Note
  // `verify-ca`, NOT `verify-full`: the SAN above does not contain the proxy
  // hostname we connect to, so hostname checking can never pass and we do not
  // control issuance. Both outcomes were verified against the live server.
  //
  //   npx wrangler cert upload certificate-authority \
  //     --ca-cert certs/railway-postgres-root-ca.pem --name railway-bounties-ca
  //   npx wrangler hyperdrive create spark-bounties \
  //     --connection-string="postgresql://bounties_app:PASSWORD@altaria.proxy.rlwy.net:52027/railway" \
  //     --ca-certificate-id <id from the upload> --sslmode verify-ca
  //
  // The id below is live. No code changes were needed: src/lib/db.ts already
  // prefers the binding over DATABASE_URL.
  //
  // LOCAL DEV needs one extra step, because of that same preference. Under
  // `astro dev` the binding exists and db.ts takes it, so the DATABASE_URL in
  // .dev.vars is ignored; wrangler also refuses to start local emulation with
  // no local connection string at all. Export a real dev database URL:
  //
  //   export CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=<dev db url>
  //
  // Do NOT add a placeholder "localConnectionString" here instead. It silences
  // the startup error and then shadows DATABASE_URL, so every DB-backed page
  // fails against an address nothing is listening on. Deploys never need it:
  // the wrangler check is gated on local emulation.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0e0e6b931a654f4f8ebc183eb0ef0bc7"
    }
  ],
  // Without this the Worker exists only at its workers.dev address: the build
  // goes green, the deploy succeeds, and every documented URL — including the
  // Slack slash-command endpoint — resolves to NXDOMAIN. `custom_domain: true`
  // makes wrangler create the DNS record, the same way atlas.buspark.io is set
  // up, so this needs no dashboard step.
  //
  // hackbu.buspark.io serves /tracks/hackbu, not the board root. That mapping
  // lives in src/middleware.ts (with src/lib/hostname.ts), which is why this
  // hostname can be a plain custom_domain: the Worker decides what to serve
  // from the Host header, so no Cloudflare rewrite rule is involved.
  //
  // It only works because src/pages/index.astro sets `prerender = false`. A
  // prerendered `/` is answered from the asset binding without entering the
  // Astro app, so middleware never sees it. Re-prerendering that page breaks
  // this hostname while every build stays green — see the note there.
  "routes": [
    {
      "pattern": "bounties.buspark.io",
      "custom_domain": true
    },
    {
      "pattern": "hackbu.buspark.io",
      "custom_domain": true
    }
  ],
  // Secrets are NOT set here — use `wrangler secret put`. All are configured on
  // the bounties-site service as of 2026-09-14:
  //   EVENTBRITE_TOKEN
  //   SLACK_SIGNING_SECRET
  //   MAILCHIMP_API_KEY / MAILCHIMP_AUDIENCE_ID
  //   ADMIN_KEY
  // DATABASE_URL is NOT among them and is not needed: the Hyperdrive binding
  // above wins in production. See README.md § "Environment".
  "observability": {
    "enabled": true
  }
}
