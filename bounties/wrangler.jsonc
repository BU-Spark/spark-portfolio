{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Must match the Cloudflare Workers service EXACTLY. Workers Builds runs
  // `wrangler deploy`, which refuses when this name differs from the service
  // it is attached to. atlas/wrangler.int.jsonc <-> spark-portfolio-int is the
  // pattern that works; "spark-bounties" here against a service called
  // bounties-site is what broke the build.
  "name": "bounties-site",
  "compatibility_date": "2026-07-24",
  // Required by `pg`, which reaches for node:net/node:tls. (It was previously
  // required for node:crypto's MD5 — that need went away with Mailchimp, but
  // the Postgres driver needs the flag regardless.) atlas sets the same flag.
  "compatibility_flags": ["nodejs_compat"],
  // Wrangler runs this itself before bundling, so `wrangler versions upload`
  // and `wrangler deploy` cannot be invoked against a dist/ that was never
  // generated. Workers Builds has a "Build command" field in the dashboard that
  // does the same job, but it is invisible to this repo and was twice left
  // empty — producing `The entry-point file at "dist/_worker.js/index.js" was
  // not found`, which reads like a code fault and is not one. Declaring it here
  // makes the deploy self-contained and reviewable.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "main": "./dist/_worker.js/index.js",
  // HYPERDRIVE IS REQUIRED IN PRODUCTION. It is not an optimisation here.
  //
  // A direct DATABASE_URL connection works locally and CANNOT work from a
  // Worker, for a reason that has nothing to do with the code. Railway's
  // Postgres serves a certificate from a private CA:
  //
  //     subject CN=localhost   issuer CN=root-ca
  //     SAN     DNS:localhost, DNS:postgres-b1fc.railway.internal
  //
  // Node accepts that when told `rejectUnauthorized: false`. The Workers
  // runtime has no equivalent — connect()/startTls() validate against
  // Cloudflare's trust store with no documented way to opt out — so the
  // handshake fails and pg reports the generic
  // "Connection terminated unexpectedly". That is what production showed
  // with DATABASE_URL correctly set.
  //
  // Hyperdrive can be told which CA to trust, so it is the way in. Note
  // `verify-ca`, NOT `verify-full`: the SAN above does not contain the proxy
  // hostname we connect to, so hostname checking can never pass and we do not
  // control issuance. Both outcomes were verified against the live server.
  //
  //   npx wrangler cert upload certificate-authority \
  //     --ca-cert certs/railway-postgres-root-ca.pem --name railway-bounties-ca
  //   npx wrangler hyperdrive create spark-bounties \
  //     --connection-string="postgresql://bounties_app:PASSWORD@altaria.proxy.rlwy.net:52027/railway" \
  //     --ca-certificate-id <id from the upload> --sslmode verify-ca
  //
  // Then uncomment the block below with the returned Hyperdrive id. No code
  // changes: src/lib/db.ts already prefers the binding over DATABASE_URL.
  // Keep the DATABASE_URL secret set — it is what local dev uses.
  //
  // A placeholder id is worse than nothing: wrangler hard-fails the deploy on
  // an unknown Hyperdrive id, which is why this stays commented until the id
  // exists.
  //
  // "hyperdrive": [
  //   {
  //     "binding": "HYPERDRIVE",
  //     "id": "<id from `wrangler hyperdrive create`>",
  //     // Required for DEPLOYS too, not just local dev, despite the name:
  //     // wrangler calls getPlatformProxy() to read the env, which spins up
  //     // miniflare, and miniflare cannot use a real Hyperdrive config.
  //     "localConnectionString": "postgresql://placeholder:placeholder@127.0.0.1:5432/unused"
  //   }
  // ],
  // Secrets are NOT set here — use `wrangler secret put`:
  //   DATABASE_URL           (required; see the note above)
  //   EVENTBRITE_TOKEN
  //   SLACK_SIGNING_SECRET   (only if /bounty-signups is in use)
  // See README.md § "Environment".
  "observability": {
    "enabled": true
  }
}
