# Generated by `astro build`/`astro check` from astro.config.mjs.
src/env.d.ts

# The repo root .gitignore has bare `*.json` and `*.png` rules. Without these
# re-includes they swallow package.json, package-lock.json, tsconfig.json and
# public/spark-logo.png — silently, since the build works locally from files
# that were never committed. hub/.gitignore documents having already shipped a
# commit missing its logo this way; atlas/.gitignore carries the same pair.
!*.json
!*.png
